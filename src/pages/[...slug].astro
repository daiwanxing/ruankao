---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Pagination from '../components/Pagination.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  // 排除 manifest 和其他静态资源请求
  const excludePatterns = ['manifest.webmanifest', 'manifest.json', 'service-worker.js'];

  return docs
    .filter((entry) => !excludePatterns.includes(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 获取所有文档用于分页
const allDocs = await getCollection('docs');
const currentIndex = allDocs.findIndex((doc) => doc.id === entry.id);
const prevDoc = currentIndex > 0 ? allDocs[currentIndex - 1] : null;
const nextDoc = currentIndex < allDocs.length - 1 ? allDocs[currentIndex + 1] : null;

const currentPath = `/${entry.id}`;
---

<DocLayout title={entry.data.title} description={entry.data.description}>
  <Header currentPath={currentPath} />

  <div class="layout">
    <Sidebar currentPath={currentPath} />

    <main class="main-content">
      <article class="content-container" data-has-toc={headings.length > 0}>
        <!-- 页面标题 -->
        <header class="doc-header">
          {entry.data.sidebar?.badge && (
            <span class="doc-badge" data-variant={entry.data.sidebar.badge.variant}>
              {entry.data.sidebar.badge.text}
            </span>
          )}
          <h1 class="doc-title">{entry.data.title}</h1>
          {entry.data.description && (
            <p class="doc-description">{entry.data.description}</p>
          )}
        </header>

        <!-- 文档内容 -->
        <div class="doc-content sl-markdown-content">
          <Content />
        </div>

        <!-- 翻页导航 -->
        <Pagination
          prev={prevDoc ? { href: `/${prevDoc.id}`, label: prevDoc.data.title } : undefined}
          next={nextDoc ? { href: `/${nextDoc.id}`, label: nextDoc.data.title } : undefined}
        />

        <!-- 页脚 -->
        <Footer currentPath={currentPath} />
      </article>
    </main>

    <!-- 右侧目录 -->
    <TableOfContents headings={headings} />
  </div>
</DocLayout>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
    padding-top: var(--header-height);
  }

  .main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding: var(--space-8);
    max-width: calc(100% - var(--sidebar-width));
  }

  .content-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  /* 文档头部 */
  .doc-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .doc-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .doc-badge[data-variant="tip"] {
    background-color: var(--color-brand-primary);
    color: white;
  }

  .doc-badge[data-variant="important"] {
    background-color: var(--color-error);
    color: white;
  }

  .doc-badge[data-variant="note"] {
    background-color: var(--color-info);
    color: white;
  }

  .doc-badge[data-variant="new"] {
    background-color: var(--color-success);
    color: white;
  }

  .doc-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-text-emphasized);
    margin: 0 0 var(--space-3) 0;
  }

  .doc-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* 文档内容 */
  .doc-content {
    line-height: var(--leading-relaxed);
  }

  /* 响应式 */
  @media (max-width: 1280px) {
    .main-content {
      margin-right: 0;
      max-width: calc(100% - var(--sidebar-width));
    }
  }

  @media (max-width: 1024px) {
    .main-content {
      margin-left: 0;
      max-width: 100%;
      padding: var(--space-4);
    }
  }

  @media (max-width: 768px) {
    .doc-title {
      font-size: var(--text-3xl);
    }

    .doc-description {
      font-size: var(--text-base);
    }
  }
</style>
