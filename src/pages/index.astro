---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Footer from '../components/Footer.astro';

// 获取首页内容 - glob loader 可能返回 'index' 或 'index.mdx'
const docs = await getCollection('docs');
const indexDoc = docs.find(doc => doc.id === 'index' || doc.id === 'index.mdx');

if (!indexDoc) {
  throw new Error('Index document not found');
}

const { Content, headings } = await render(indexDoc);
const currentPath = '/';
---

<DocLayout title={indexDoc.data.title} description={indexDoc.data.description}>
  <Header currentPath={currentPath} />

  <div class="layout">
    <Sidebar currentPath={currentPath} />

    <main class="main-content">
      <article class="content-container">
        <!-- 页面标题 -->
        <header class="doc-header">
          {indexDoc.data.sidebar?.badge && (
            <span class="doc-badge" data-variant={indexDoc.data.sidebar.badge.variant}>
              {indexDoc.data.sidebar.badge.text}
            </span>
          )}
          <h1 class="doc-title">{indexDoc.data.title}</h1>
          {indexDoc.data.description && (
            <p class="doc-description">{indexDoc.data.description}</p>
          )}
        </header>

        <!-- 文档内容 -->
        <div class="doc-content sl-markdown-content">
          <Content />
        </div>

        <!-- 页脚 -->
        <Footer currentPath={currentPath} />
      </article>
    </main>
  </div>
</DocLayout>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
    padding-top: var(--header-height);
  }

  .main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding: var(--space-8);
    max-width: calc(100% - var(--sidebar-width));
  }

  .content-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .doc-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .doc-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .doc-badge[data-variant="tip"] {
    background-color: var(--color-brand-primary);
    color: white;
  }

  .doc-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-text-emphasized);
    margin: 0 0 var(--space-3) 0;
  }

  .doc-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 1024px) {
    .main-content {
      margin-left: 0;
      max-width: 100%;
      padding: var(--space-4);
    }
  }
</style>
