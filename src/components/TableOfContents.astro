---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocItem[];
}

const { headings } = Astro.props;

// 过滤出 h2 和 h3 标题
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 0 && (
  <aside class="toc" id="table-of-contents">
    <nav class="toc-nav" aria-label="页面目录">
      <h4 class="toc-title">目录</h4>
      <ul class="toc-list">
        {toc.map((heading) => (
          <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
            <a
              href={`#${heading.slug}`}
              class="toc-link"
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  function initToc() {
    const tocLinks = document.querySelectorAll('.toc-link');
    if (tocLinks.length === 0) return;

    // 创建 Intersection Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = entry.target.getAttribute('id');
          const link = document.querySelector(`.toc-link[data-slug="${slug}"]`);

          if (entry.isIntersecting) {
            // 移除所有 active 状态
            tocLinks.forEach((l) => l.classList.remove('active'));
            // 添加 active 状态到当前链接
            link?.classList.add('active');
          }
        });
      },
      {
        rootMargin: '-80px 0px -80% 0px',
        threshold: 0,
      }
    );

    // 观察所有标题元素
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      const heading = document.getElementById(slug || '');
      if (heading) {
        observer.observe(heading);
      }
    });

    // 点击平滑滚动
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = (link as HTMLAnchorElement).getAttribute('data-slug');
        const heading = document.getElementById(slug || '');
        if (heading) {
          heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // 更新 URL
          history.pushState(null, '', `#${slug}`);
        }
      });
    });
  }

  // 初始执行
  initToc();

  // View Transitions 支持
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .toc {
    position: fixed;
    top: var(--header-height);
    right: 0;
    width: var(--toc-width);
    height: calc(100vh - var(--header-height));
    padding: var(--space-4);
    overflow-y: auto;
    border-left: 1px solid var(--color-border);
    background-color: var(--color-bg-sidebar);
  }

  .toc-nav {
    position: sticky;
    top: var(--space-4);
  }

  .toc-title {
    margin: 0 0 var(--space-3) 0;
    padding-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-divider);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-card);
    text-decoration: none;
  }

  .toc-link.active {
    color: var(--color-brand-primary);
    background-color: rgba(96, 165, 250, 0.1);
  }

  .toc-depth-3 {
    padding-left: var(--space-4);
  }

  /* 响应式 */
  @media (max-width: 1280px) {
    .toc {
      display: none;
    }
  }
</style>
