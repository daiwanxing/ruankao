---
interface Props {
  questionId?: string;
  question: string;
  options: string[];
  answer: string;
  explanation?: string;
}

const { questionId: providedQuestionId, question, options, answer, explanation } = Astro.props;

// 自动生成questionId（如果未提供）
const questionId = providedQuestionId || `q_${question.split('').reduce((acc, char) => {
  return ((acc << 5) - acc) + char.charCodeAt(0);
}, 0).toString(36)}`;

// 生成缓存 key
const storageKey = `exercise_${questionId}`;
---

<div class="exercise-box" data-question-id={questionId} data-correct-answer={answer} data-storage-key={storageKey}>
  <div class="question-header">
    <span class="question-badge">练习</span>
    <h4 class="question">{question}</h4>
  </div>
  <ul class="options">
    {options.map((opt, index) => {
      const optionLetter = String.fromCharCode(65 + index);
      return (
        <li class="option-item" data-option={optionLetter}>
          <span class="option-indicator">{optionLetter}</span>
          <span class="option-text">{opt}</span>
        </li>
      );
    })}
  </ul>
  <div class="result-section" style="display: none;">
    <div class="result-header"></div>
    <div class="explanation-content" style="display: none;">
      {explanation && <p><span class="explanation-label">解析</span><span set:html={explanation.replace(/\\n|\n/g, '<br />')} /></p>}
    </div>
  </div>
</div>

<script>
  function initExerciseBoxes() {
    const exerciseBoxes = document.querySelectorAll('.exercise-box');

    exerciseBoxes.forEach(box => {
      const element = box as HTMLElement;
      if (element.dataset.initialized) return;
      element.dataset.initialized = 'true';

      const questionId = element.dataset.questionId;
      const correctAnswer = element.dataset.correctAnswer;
      const storageKey = element.dataset.storageKey;
      const options = element.querySelectorAll('.option-item');
      const resultSection = element.querySelector('.result-section') as HTMLElement;
      const resultHeader = element.querySelector('.result-header') as HTMLElement;
      const explanationContent = element.querySelector('.explanation-content') as HTMLElement;

      const savedAnswer = sessionStorage.getItem(storageKey || '');

      if (savedAnswer) {
        lockExercise(element, options, resultSection, resultHeader, explanationContent, savedAnswer, correctAnswer || '');
      }

      options.forEach(option => {
        const optElement = option as HTMLLIElement;
        optElement.addEventListener('click', () => {
          if (sessionStorage.getItem(storageKey || '')) {
            return;
          }

          const selectedOption = optElement.dataset.option;
          if (!selectedOption) return;

          sessionStorage.setItem(storageKey || '', selectedOption);
          lockExercise(element, options, resultSection, resultHeader, explanationContent, selectedOption, correctAnswer || '');
        });
      });
    });
  }

  function lockExercise(
    element: HTMLElement,
    options: NodeListOf<Element>,
    resultSection: HTMLElement,
    resultHeader: HTMLElement,
    explanationContent: HTMLElement,
    selectedOption: string,
    correctAnswer: string
  ) {
    const isCorrect = selectedOption === correctAnswer;

    element.classList.add('is-locked');

    options.forEach(opt => {
      const optElement = opt as HTMLLIElement;
      const optLetter = optElement.dataset.option;

      if (optLetter === selectedOption) {
        opt.classList.add('selected');
        if (isCorrect) {
          opt.classList.add('correct');
        } else {
          opt.classList.add('incorrect');
        }
      } else if (optLetter === correctAnswer && !isCorrect) {
        opt.classList.add('correct');
      }
    });

    if (resultSection) resultSection.style.display = 'block';

    if (resultHeader) {
      if (isCorrect) {
        resultHeader.innerHTML = '<span class="result-icon">✓</span> <span class="result-text">回答正确</span>';
        resultHeader.className = 'result-header correct';
      } else {
        resultHeader.innerHTML = `<span class="result-icon">✗</span> <span class="result-text">正确答案是 ${correctAnswer}</span>`;
        resultHeader.className = 'result-header incorrect';
      }
    }

    if (explanationContent) explanationContent.style.display = 'block';
  }

  initExerciseBoxes();
  document.addEventListener('astro:page-load', initExerciseBoxes);
</script>

<style>
  .exercise-box {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 16px;
    padding: 1.5rem;
    margin: 2rem 0;
    background: var(--sl-color-bg);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .exercise-box:hover {
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: 0 8px 32px rgba(99, 102, 241, 0.1);
  }

  .question-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .question-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .question {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .options {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .option-item {
    display: flex;
    align-items: flex-start;
    padding: 0.875rem 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid transparent;
    border-radius: 10px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .option-item:hover {
    background: var(--sl-color-gray-5);
    border-color: rgba(99, 102, 241, 0.4);
    transform: translateX(4px);
  }

  .exercise-box.is-locked .option-item {
    cursor: default;
    pointer-events: none;
    opacity: 0.6;
  }

  .exercise-box.is-locked .option-item:hover {
    transform: none;
    background: var(--sl-color-gray-6);
    border-color: transparent;
  }

  .exercise-box.is-locked .option-item.correct {
    opacity: 1;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(16, 185, 129, 0.1) 100%);
    border-color: rgba(34, 197, 94, 0.4);
  }

  .exercise-box.is-locked .option-item.incorrect {
    opacity: 1;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.1) 100%);
    border-color: rgba(239, 68, 68, 0.4);
  }

  .exercise-box.is-locked .option-item.correct:hover,
  .exercise-box.is-locked .option-item.incorrect:hover {
    transform: none;
  }

  .option-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  .option-item.correct .option-indicator {
    background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
  }

  .option-item.incorrect .option-indicator {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  }

  .option-text {
    flex: 1;
    line-height: 1.6;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
  }

  .result-section {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: 10px;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 500;
  }

  .result-header.correct {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(16, 185, 129, 0.1) 100%);
    color: #4ade80;
  }

  .result-header.incorrect {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.1) 100%);
    color: #f87171;
  }

  .result-icon {
    font-weight: 700;
  }

  .explanation-content {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .explanation-content p {
    margin: 0;
    line-height: 1.8;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
  }

  .explanation-label {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    margin-right: 0.5rem;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .exercise-box {
      padding: 1.25rem;
      margin: 1.5rem 0;
    }

    .question {
      font-size: 1rem;
    }

    .option-item {
      padding: 0.75rem;
    }

    .option-text {
      font-size: 0.9rem;
    }
  }
</style>
